{
  "name": "kanban",
  "private": true,
  "version": "1.0.1",
  "description": "A Kanban board application",
  "author": {
    "name": "Nightmarius",
    "email": "m@nightmarius.com"
  },
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "node electron/run-dev.cjs",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "asar": false,
    "appId": "com.nightmarius.kanban",
    "productName": "Kanban",
    "files": [
      "dist/web/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist/release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/Icon.png"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/Icon.png",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.0"
  }
}
